diff --git a/src/check_binary_defaults.rs b/src/check_binary_defaults.rs
new file mode 100644
index 000000000..957b7b187
--- /dev/null
+++ b/src/check_binary_defaults.rs
@@ -0,0 +1,43 @@
+use super::*;
+
+impl Checker<'_> {
+    pub(super) fn physical_default_values(
+        &self,
+        method: &JavaMethod,
+        values: &mut [Value],
+        mask: u64,
+        offset: usize,
+    ) -> Result<()> {
+        let Some(library) = &method.library else {
+            return Ok(());
+        };
+        if mask == 0 || !library.kotlin_declared || self.classpath.is_source(&method.owner) {
+            return Ok(());
+        }
+        let (mut storage, _) = crate::jvm_descriptor::method_types(&method.descriptor)?;
+        if library.suspend_
+            && storage.last() == Some(&Type::Java("kotlin/coroutines/Continuation".into()))
+        {
+            storage.pop();
+        }
+        let Some(dispatch) = values.len().checked_sub(storage.len()).filter(|n| *n <= 1) else {
+            return Err(Diagnostic::new(
+                offset,
+                "Kotlin default argument storage does not match its JVM declaration",
+            )
+            .with_kind(
+                crate::DiagnosticKind::UnsupportedLanguage,
+                "KOTLIN_DEFAULT_ARGUMENT_ABI_UNSUPPORTED",
+            ));
+        };
+        let reserved =
+            usize::from(library.receiver.is_some()) + usize::from(library.value_dispatch);
+        for (index, storage) in storage.into_iter().enumerate().skip(reserved) {
+            let parameter = index - reserved;
+            if parameter < 64 && mask & (1u64 << parameter) != 0 {
+                values[dispatch + index] = zero_value(&storage);
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/src/check_constructor_bridges.rs b/src/check_constructor_bridges.rs
new file mode 100644
index 000000000..c61b04f25
--- /dev/null
+++ b/src/check_constructor_bridges.rs
@@ -0,0 +1,124 @@
+use super::*;
+
+impl Checker<'_> {
+    pub(super) fn binary_marker_constructor(
+        &mut self,
+        class: &JavaClass,
+        method: &JavaMethod,
+        args: &[Expr],
+        result: Type,
+        offset: usize,
+    ) -> Result<Option<Value>> {
+        const MARKER: &str = "Lkotlin/jvm/internal/DefaultConstructorMarker;)V";
+        if self.classpath.is_source(&class.name)
+            || class
+                .library
+                .as_ref()
+                .is_some_and(|library| library.value_class.is_some())
+            || !method
+                .library
+                .as_ref()
+                .is_some_and(|library| library.kotlin_declared)
+        {
+            return Ok(None);
+        }
+        let Some(prefix) = method.descriptor.strip_suffix(MARKER) else {
+            return Ok(None);
+        };
+        let (params, defaults) = Self::method_parameters(method)?;
+        let base_descriptor = format!("{prefix})V");
+        let (storage, _) = crate::jvm_descriptor::method_types(&base_descriptor).map_err(|_| {
+            Diagnostic::new(offset, "Malformed Kotlin constructor bridge descriptor")
+        })?;
+        if storage.len() != params.len() {
+            return Ok(None);
+        }
+        if !self
+            .classpath
+            .constructor_visible(&self.lambda_owner, method)
+        {
+            return Err(
+                Diagnostic::new(offset, "Constructor is inaccessible").with_kind(
+                    crate::DiagnosticKind::InvalidKotlin,
+                    "INACCESSIBLE_CONSTRUCTOR",
+                ),
+            );
+        }
+        if self.public_inline_body && method.kotlin_internal {
+            return Err(Diagnostic::new(
+                offset,
+                "Public inline functions cannot access nonpublic constructors",
+            )
+            .with_kind(
+                crate::DiagnosticKind::InvalidKotlin,
+                "PUBLIC_INLINE_NON_PUBLIC_ACCESS",
+            ));
+        }
+        let (values, lets, mask) = self.arguments_checked(
+            &params,
+            &defaults,
+            args,
+            self.method_named(method),
+            false,
+            offset,
+        )?;
+        let mut values = values
+            .into_iter()
+            .zip(storage)
+            .enumerate()
+            .map(|(index, (value, storage))| {
+                if mask != 0 && index < 64 && mask & (1u64 << index) != 0 {
+                    zero_value(&storage)
+                } else {
+                    value
+                }
+            })
+            .collect::<Vec<_>>();
+        let descriptor = if mask == 0 {
+            method.descriptor.clone()
+        } else {
+            let words = params.len().div_ceil(32);
+            let descriptor = format!("{prefix}{}{MARKER}", "I".repeat(words));
+            let bridge = class
+                .methods
+                .iter()
+                .find(|candidate| {
+                    candidate.name == "<init>"
+                        && candidate.descriptor == descriptor
+                        && candidate.access & 0x1009 == 0x1001
+                })
+                .ok_or_else(|| {
+                    Diagnostic::new(
+                        offset,
+                        "Accessible Kotlin default constructor bridge is unavailable",
+                    )
+                    .with_kind(
+                        crate::DiagnosticKind::UnsupportedLanguage,
+                        "KOTLIN_CONSTRUCTOR_DEFAULT_ABI_UNSUPPORTED",
+                    )
+                })?;
+            for word in 0..words {
+                values.push(Value {
+                    ty: Type::Int,
+                    kind: ValueKind::Int((mask >> (word * 32)) as i32),
+                });
+            }
+            bridge.descriptor.clone()
+        };
+        values.push(Value {
+            ty: Type::Java("kotlin/jvm/internal/DefaultConstructorMarker".into()),
+            kind: ValueKind::Null,
+        });
+        Ok(Some(Self::wrap_lets(
+            Value {
+                ty: result,
+                kind: ValueKind::New {
+                    owner: class.name.clone(),
+                    descriptor,
+                    args: values,
+                },
+            },
+            lets,
+        )))
+    }
+}
diff --git a/src/check_java_nullability.rs b/src/check_java_nullability.rs
new file mode 100644
index 000000000..29fb86904
--- /dev/null
+++ b/src/check_java_nullability.rs
@@ -0,0 +1,48 @@
+use super::*;
+
+impl Checker<'_> {
+    fn java_nonnull_message(&self, value: &Value) -> Option<String> {
+        if !value.ty.is_reference()
+            || value.ty.is_nullable()
+            || matches!(value.ty, Type::Platform(_))
+        {
+            return None;
+        }
+        match &value.kind {
+            ValueKind::JavaCall { method, .. } | ValueKind::MemberCall { method, .. }
+                if method
+                    .library
+                    .as_ref()
+                    .is_some_and(|library| !library.kotlin_declared) =>
+            {
+                Some(format!("{}(...)", method.name))
+            }
+            ValueKind::JavaField { owner, name, .. } => self
+                .classpath
+                .field_candidates(owner, name)
+                .ok()?
+                .iter()
+                .find(|field| {
+                    field.kotlin.is_none()
+                        && field.java_type.as_deref().is_some_and(|ty| {
+                            ty.is_reference()
+                                && !ty.is_nullable()
+                                && !matches!(ty, Type::Platform(_))
+                        })
+                })
+                .map(|_| name.clone()),
+            ValueKind::Let { body, .. } => self.java_nonnull_message(body),
+            _ => None,
+        }
+    }
+
+    pub(super) fn enhanced_java_nonnull(&self, value: Value) -> Value {
+        let Some(message) = self.java_nonnull_message(&value) else {
+            return value;
+        };
+        Value {
+            ty: value.ty.clone(),
+            kind: ValueKind::NotNull(Box::new(value), message),
+        }
+    }
+}
