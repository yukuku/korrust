+package binarydefaults.library
+@JvmInline value class Key(val raw: Long) {
+    fun plus(other: Key = Key(7L)): Key = Key(raw + other.raw)
+}
+@JvmInline value class Label(val raw: String)
+@JvmInline value class Small(val raw: Int)
