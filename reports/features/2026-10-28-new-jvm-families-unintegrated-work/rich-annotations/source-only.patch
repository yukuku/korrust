+pub(crate) fn header(module: &Module, name: &str, cp: &Classpath) -> Result<crate::classpath::JavaClass> {
+    use crate::classpath::{JavaClass, JavaMethod, LibraryClass, LibraryMethod};
+    let definition = definition(module, name, cp)?;
