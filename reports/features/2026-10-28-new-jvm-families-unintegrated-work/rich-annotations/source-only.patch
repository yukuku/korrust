+pub(crate) fn value(expression: &Expr, descriptor: &str, imports: &HashMap<String, String>, cp: &Classpath, depth: usize, scope: Option<&str>) -> Result<Value> {
+    if depth > 32 { return Err(unsupported(expression.offset, "Annotation nesting exceeds the current limit", "ANNOTATION_DEPTH_UNSUPPORTED")); }
+    if let Some(component) = descriptor.strip_prefix('[') {
+        let expressions = if let ExprKind::AnnotationArray(values) = &expression.kind { values.as_slice() }
+        else if let ExprKind::Call(target, arguments) = &expression.kind {
+            let name = path(target).ok_or_else(|| invalid(expression.offset, "Expected an annotation array constructor"))?;
+            let canonical = imports.get(&name).cloned().unwrap_or_else(|| if name.contains('/') { name.clone() } else { format!("kotlin/{name}") });
+            let (package, name) = canonical.rsplit_once('/').ok_or_else(|| invalid(expression.offset, "Unresolved annotation array constructor"))?;
+            let methods = cp.package_methods(package, name)?;
+            let methods = methods.iter().filter(|m| m.library.as_ref().is_some_and(|l| l.builtin_array)).collect::<Vec<_>>();
+            if methods.is_empty() { return Err(invalid(expression.offset, "Annotation arrays require a resolved builtin array constructor")); }
+            if !methods.iter().any(|m| m.descriptor.rsplit_once(')').is_some_and(|(_, result)| result == descriptor || result == "[Ljava/lang/Object;" && component.starts_with('L'))) { return Err(invalid(expression.offset, "Annotation array factory has a different array representation")); }
+            if let ExprKind::Generic(_, types) = &target.kind {
+                if types.len() != 1 || !methods.iter().any(|m| m.library.as_ref().is_some_and(|l| l.type_parameters.len() == 1)) { return Err(invalid(expression.offset, "Annotation array constructor has invalid type arguments")); }
+                let explicit = logical_type(&types[0], imports, cp, expression.offset)?;
+                if element_descriptor(&explicit, cp, expression.offset)? != component { return Err(invalid(expression.offset, "Annotation array type argument mismatch")); }
+            }
+            arguments.as_slice()
+        } else { return Err(invalid(expression.offset, "Expected an annotation array value")); };
+        let mut values = Vec::new();
+        for expression in expressions {
+            if let ExprKind::Unary(operator, inner) = &expression.kind && operator == "*" {
+                let Value::Array(spread) = value(inner, descriptor, imports, cp, depth + 1, scope)? else { return Err(invalid(expression.offset, "Annotation spread requires an array")); };
+                values.extend(spread);
+            } else { values.push(value(expression, component, imports, cp, depth + 1, scope)?); }
+        }
+        return Ok(Value::Array(values));
+    }
+    if descriptor == "Ljava/lang/Class;" { return class_literal_value(expression, imports, cp, scope); }
+    if let Some(class_name) = descriptor.strip_prefix('L').and_then(|name| name.strip_suffix(';')) && class_name != "java/lang/String" {
+        let class = cp.load(class_name)?;
+        if class.access & 0x4000 != 0 {
+            return Ok(Value::Enum { descriptor: descriptor.into(), entry: enum_entry(expression, class_name, imports, cp)? });
+        }
+        if class.access & 0x2000 != 0 {
+            let ExprKind::Call(target, arguments) = &expression.kind else { return Err(invalid(expression.offset, "Expected a nested annotation constructor")); };
+            let target_name = path(target).ok_or_else(|| invalid(expression.offset, "Expected a nested annotation classifier"))?;
+            if owner(&target_name, imports, cp) != class_name { return Err(invalid(expression.offset, "Nested annotation has a different type")); }
+            let arguments = arguments.iter().map(|argument| if let ExprKind::NamedArgument(name, expression) = &argument.kind { (Some(name.clone()), expression.as_ref().clone()) } else { (None, argument.clone()) }).collect::<Vec<_>>();
+            return Ok(Value::Nested(Box::new(arguments_value(class_name, &arguments, expression.offset, imports, cp, depth + 1, scope)?)));
+        }
+        return Err(invalid(expression.offset, "Annotation value has a non-annotation reference type"));
+    }
+    let folded = crate::const_eval::fold_expression(expression, &mut |_, offset| Err(invalid(offset, "Unresolved annotation constant reference")))?;
+    use crate::syntax::ConstValue;
+    match (folded, descriptor) {
+        (ConstValue::Int(value), "I") => Ok(Value::Int(value)),
+        (ConstValue::Int(value), "J") if crate::const_eval::integer_literal_expression(expression) => Ok(Value::Long(i64::from(value))),
+        (ConstValue::Long(value), "J") => Ok(Value::Long(value)),
+        (ConstValue::Float(value), "F") => Ok(Value::Float(value)),
+        (ConstValue::Double(value), "D") => Ok(Value::Double(value)),
+        (ConstValue::Char(value), "C") => Ok(Value::Char(value)),
+        (ConstValue::Boolean(value), "Z") => Ok(Value::Boolean(value)),
+        (ConstValue::String(value), "Ljava/lang/String;") => Ok(Value::String(value)),
+        (_, "B" | "S") => Err(unsupported(expression.offset, "Byte and Short annotation values are unsupported", "ANNOTATION_BYTE_SHORT_UNSUPPORTED")),
+        _ => Err(invalid(expression.offset, "Annotation argument type mismatch")),
+    }
+}
+
+fn class_literal_value(expression: &Expr, imports: &HashMap<String, String>, cp: &Classpath, scope: Option<&str>) -> Result<Value> {
+    let ExprKind::ClassLiteral { receiver, classifier: Some(source) } = &expression.kind else { return Err(invalid(expression.offset, "Annotation class arguments require a pure classifier literal")); };
+    let source_path = path(receiver).ok_or_else(|| invalid(expression.offset, "Annotation class arguments cannot use bound expressions"))?;
+    let head = source_path.split('/').next().unwrap();
+    if let Some(scope) = scope {
+        let class = cp.load(scope)?;
+        if class.fields.iter().any(|field| field.name == head) || class.methods.iter().any(|method| method.source_property.as_deref() == Some(head) || method.name == "<init>" && method.kotlin_params.as_ref().is_some_and(|parameters| parameters.iter().any(|(name, _, _)| name == head))) { return Err(invalid(expression.offset, "Annotation class literal receiver is a lexical value")); }
+    }
+    if let Some(binding) = imports.get(head) {
+        if binding.contains("::") { return Err(invalid(expression.offset, "Annotation class arguments cannot use value bindings")); }
+        if let Some((package, name)) = binding.rsplit_once('/') {
+            if !cp.package_constants(package, name)?.is_empty() || cp.package_methods(package, name)?.iter().any(|m| m.source_property.as_deref() == Some(name)) { return Err(invalid(expression.offset, "Annotation class arguments cannot use value bindings")); }
+        }
+    }
+    fn normalize(source: &Type, imports: &HashMap<String, String>, cp: &Classpath, depth: usize, offset: usize) -> Result<Type> {
+        if depth > 64 { return Err(unsupported(offset, "Annotation class nesting exceeds the current limit", "ANNOTATION_CLASS_DEPTH_UNSUPPORTED")); }
+        let primitive = match source {
+            Type::Java(name) => match name.as_str() { "kotlin/Int" => Some(Type::Int), "kotlin/Long" => Some(Type::Long), "kotlin/Byte" => Some(Type::Byte), "kotlin/Char" => Some(Type::Char), "kotlin/Boolean" => Some(Type::Boolean), "kotlin/Float" => Some(Type::Float), "kotlin/Double" => Some(Type::Double), "kotlin/String" => Some(Type::String), "kotlin/Unit" => Some(Type::Unit), "Any" | "kotlin/Any" => Some(Type::Java("java/lang/Object".into())), "Short" | "kotlin/Short" | "ShortArray" | "kotlin/ShortArray" => return Err(unsupported(offset, "Short class literals require unsupported primitive distinctions", "ANNOTATION_BYTE_SHORT_UNSUPPORTED")), _ => Type::primitive_array_named(name) },
+            _ => None,
+        };
+        if let Some(ty) = primitive { return Ok(ty); }
+        match source {
+            Type::Array(inner) => Ok(Type::Array(Box::new(normalize(inner, imports, cp, depth + 1, offset)?))),
+            Type::Nullable(inner) if depth != 0 => Ok(Type::Nullable(Box::new(normalize(inner, imports, cp, depth + 1, offset)?))),
+            Type::Nullable(_) => Err(invalid(offset, "Annotation class literal classifier cannot be nullable")),
+            Type::Java(name) => {
+                let canonical = owner(name, imports, cp);
+                let expanded = cp.expand_type_alias(&Type::Java(canonical.clone()), imports, &["kotlin", "java/lang"])?;
+                if expanded != Type::Java(canonical.clone()) { return normalize(&expanded, imports, cp, depth + 1, offset); }
+                let class = cp.load(&canonical)?;
+                if class.access & 1 == 0 || class.library.as_ref().and_then(|l| l.kotlin_visibility).is_some_and(|v| v == 0 && !cp.internal_visible(&canonical) || !matches!(v, 0 | 3)) { return Err(invalid(offset, "Annotation class literal classifier is inaccessible")); }
+                Ok(Type::Java(canonical))
+            }
+            Type::Parameterized { name, arguments } if name == "Array" || name == "kotlin/Array" => {
+                let [TypeArgument { variance: Variance::Invariant, ty: Some(inner) }] = arguments.as_slice() else { return Err(unsupported(offset, "Projected annotation array class literals are unsupported", "ANNOTATION_ARRAY_CLASS_PROJECTION_UNSUPPORTED")); };
+                Ok(Type::Array(Box::new(normalize(inner, imports, cp, depth + 1, offset)?)))
+            }
+            Type::Parameterized { .. } => Err(invalid(offset, "Parameterized non-array class literals are invalid")),
+            Type::Parameter { .. } => Err(unsupported(offset, "Type parameter annotation class literals require reification", "ANNOTATION_REIFIED_CLASS_UNSUPPORTED")),
+            other => Ok(other.clone()),
+        }
+    }
+    let source = if let Some(binding) = imports.get(&source_path).filter(|binding| cp.load(binding).is_ok()) { Type::Java(binding.clone()) } else { source.clone() };
+    let logical = normalize(&source, imports, cp, 0, expression.offset)?;
+    let descriptor = if logical == Type::Unit { "Lkotlin/Unit;".into() } else { logical.descriptor() };
+    Ok(Value::Class { logical, descriptor })
+}
