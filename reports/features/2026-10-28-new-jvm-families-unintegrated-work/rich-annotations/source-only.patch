+    val pack = Pack::class.primaryConstructor!!.parameters.single()
+    check(pack.name == "entries")
+    check(pack.isVararg)
+    check(!pack.isOptional)
+    check(Rich::class.annotations.filterIsInstance<Meta>().single().id == "rich")
+    println("OK:21")
+}
