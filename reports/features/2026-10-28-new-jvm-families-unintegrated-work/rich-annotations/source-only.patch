+fn invalid(offset: usize, message: impl Into<String>) -> Diagnostic {
+    Diagnostic::new(offset, message).with_kind(DiagnosticKind::InvalidKotlin, "INVALID_ANNOTATION_VALUE")
+}
+fn unsupported(offset: usize, message: &str, code: &'static str) -> Diagnostic {
+    Diagnostic::new(offset, message).with_kind(DiagnosticKind::UnsupportedLanguage, code)
+}
+
+pub(crate) fn path(expression: &Expr) -> Option<String> {
+    match &expression.kind {
+        ExprKind::Name(name) => Some(name.clone()),
+        ExprKind::Property(receiver, name) => Some(format!("{}/{name}", path(receiver)?)),
+        ExprKind::Generic(value, _) => path(value),
+        _ => None,
+    }
+}
+
+pub(crate) fn owner(name: &str, imports: &HashMap<String, String>, cp: &Classpath) -> String {
+    if let Some(imported) = imports.get(name) { return imported.clone(); }
+    if let Some((first, rest)) = name.split_once('/') {
+        if let Some(imported) = imports.get(first) {
+            let direct = format!("{imported}/{rest}");
+            if cp.load(&direct).is_ok() { return direct; }
+            return format!("{imported}${}", rest.replace('/', "$"));
+        }
+        return name.into();
+    }
+    if cp.load(name).is_ok() { return name.into(); }
+    for package in ["kotlin", "kotlin/annotation", "kotlin/reflect", "kotlin/jvm", "java/lang"] {
+        let candidate = format!("{package}/{name}");
+        if cp.load(&candidate).is_ok() { return candidate; }
+    }
+    name.into()
+}
+
+fn enum_entry(expression: &Expr, expected: &str, imports: &HashMap<String, String>, cp: &Classpath) -> Result<String> {
+    let name = path(expression).ok_or_else(|| invalid(expression.offset, "Expected an enum entry"))?;
+    let canonical = imports.get(&name).cloned().unwrap_or(name);
+    let (classifier, entry) = canonical.rsplit_once('/').ok_or_else(|| invalid(expression.offset, "Expected a qualified or imported enum entry"))?;
+    let classifier = owner(classifier, imports, cp);
+    if classifier != expected { return Err(invalid(expression.offset, "Annotation enum argument has a different enum type")); }
+    let class = cp.load(expected)?;
+    if class.access & 0x4000 == 0 || !class.fields.iter().any(|field| field.name == entry && field.descriptor == format!("L{expected};") && field.access & 0x4009 == 0x4009) {
+        return Err(invalid(expression.offset, "Unresolved annotation enum entry"));
+    }
+    Ok(entry.into())
+}
+
+pub(crate) fn logical_type(ty: &Type, imports: &HashMap<String, String>, cp: &Classpath, offset: usize) -> Result<Type> {
+    let expanded = cp.expand_type_alias(ty, imports, &["kotlin", "java/lang"])?;
+    Ok(match expanded {
+        Type::Java(name) => Type::Java(owner(&name, imports, cp)),
+        Type::Parameterized { name, arguments } => Type::Parameterized {
+            name: owner(&name, imports, cp),
+            arguments: arguments.into_iter().map(|a| Ok(TypeArgument { variance: a.variance, ty: a.ty.map(|t| logical_type(&t, imports, cp, offset)).transpose()? })).collect::<Result<_>>()?,
+        },
+        Type::Array(inner) => Type::Array(Box::new(logical_type(&inner, imports, cp, offset)?)),
+        Type::Nullable(_) | Type::Platform(_) => return Err(invalid(offset, "Annotation elements cannot be nullable or platform types")),
+        other => other,
+    })
+}
+
+pub(crate) fn element_descriptor(ty: &Type, cp: &Classpath, offset: usize) -> Result<String> {
+    match ty {
+        Type::Int | Type::Long | Type::Float | Type::Double | Type::Boolean | Type::Char | Type::String => Ok(ty.descriptor()),
+        Type::Byte | Type::ByteArray => Err(unsupported(offset, "Byte annotation elements are unsupported", "ANNOTATION_BYTE_SHORT_UNSUPPORTED")),
+        Type::IntArray | Type::LongArray | Type::FloatArray | Type::DoubleArray | Type::BooleanArray | Type::CharArray | Type::StringArray => Ok(ty.descriptor()),
+        Type::Array(inner) => {
+            if !matches!(inner.as_ref(), Type::String | Type::Java(_) | Type::Parameterized { .. }) {
+                return Err(invalid(offset, "Annotation reference arrays require String, enum, class or annotation elements"));
+            }
+            Ok(format!("[{}", element_descriptor(inner, cp, offset)?))
+        }
+        Type::Parameterized { name, arguments } if name == "kotlin/reflect/KClass" => {
+            if arguments.len() != 1 || arguments[0].ty.is_some() {
+                return Err(unsupported(offset, "Annotation KClass bounds beyond star projection are unsupported", "ANNOTATION_KCLASS_BOUND_UNSUPPORTED"));
+            }
+            Ok("Ljava/lang/Class;".into())
+        }
+        Type::Java(name) if matches!(name.as_str(), "Short" | "kotlin/Short" | "ShortArray" | "kotlin/ShortArray") => Err(unsupported(offset, "Short annotation elements are unsupported", "ANNOTATION_BYTE_SHORT_UNSUPPORTED")),
+        Type::Java(name) if matches!(name.as_str(), "UInt" | "ULong" | "UByte" | "UShort" | "kotlin/UInt" | "kotlin/ULong" | "kotlin/UByte" | "kotlin/UShort") => Err(unsupported(offset, "Unsigned annotation elements are unsupported", "ANNOTATION_UNSIGNED_UNSUPPORTED")),
+        Type::Java(name) => {
+            let class = cp.load(name)?;
+            if class.access & (0x4000 | 0x2000) == 0 { return Err(invalid(offset, "Annotation elements require an enum or annotation type")); }
+            Ok(ty.descriptor())
+        }
+        _ => Err(invalid(offset, "Invalid annotation element type")),
+    }
+}
