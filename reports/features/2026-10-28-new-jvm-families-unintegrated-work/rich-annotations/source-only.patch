+fn validate_cycles(name: &str, cp: &Classpath, active: &mut Vec<(String, bool)>, crossed_array: bool, offset: usize) -> Result<()> {
+    if let Some(index) = active.iter().position(|(owner, _)| owner == name) {
+        if crossed_array || active[index..].iter().any(|(_, array)| *array) { return Err(unsupported(offset, "Cyclic annotation parameter arrays remain an explicit specification/oracle boundary", "ANNOTATION_ARRAY_CYCLE_UNSUPPORTED")); }
+        return Err(invalid(offset, "Cyclic annotation parameter types are invalid"));
+    }
+    if active.len() > 32 { return Err(unsupported(offset, "Annotation declaration nesting exceeds the current limit", "ANNOTATION_DEPTH_UNSUPPORTED")); }
+    let class = cp.load(name)?;
+    let Some(definition) = class.annotation_definition else { return Ok(()); };
+    active.push((name.into(), crossed_array));
+    for (_, descriptor, _) in &definition.parameters {
+        let component = descriptor.trim_start_matches('[');
+        if let Some(next) = component.strip_prefix('L').and_then(|s| s.strip_suffix(';')) && cp.load(next)?.access & 0x2000 != 0 {
+            validate_cycles(next, cp, active, descriptor.starts_with('['), offset)?;
+        }
+    }
+    active.pop();
+    Ok(())
+}
