+pub(crate) fn definition(module: &Module, name: &str, cp: &Classpath) -> Result<AnnotationDefinition> {
+    let source = module.annotation_decl.as_ref().ok_or_else(|| invalid(0, "Missing source annotation declaration"))?;
+    let mut imports = imports(module, cp)?;
+    imports.insert(source.name.clone(), name.into());
+    let mut retention = AnnotationRetention::Runtime;
+    let mut targets = None;
+    let mut seen = HashSet::new();
+    for annotation in &source.annotations {
+        let canonical = owner(&annotation.name, &imports, cp);
+        if !seen.insert(canonical.clone()) { return Err(invalid(annotation.offset, "Repeated annotation meta-annotation")); }
+        if canonical == "kotlin/annotation/Repeatable" || canonical == "kotlin/jvm/JvmRepeatable" {
+            return Err(unsupported(annotation.offset, "Repeatable annotation declarations are unsupported", "REPEATABLE_ANNOTATION_UNSUPPORTED"));
+        }
+        if canonical == "kotlin/annotation/Retention" {
+            let [(_, expression)] = annotation.arguments.as_slice() else { return Err(invalid(annotation.offset, "Retention requires exactly one value")); };
+            retention = match enum_entry(expression, "kotlin/annotation/AnnotationRetention", &imports, cp)?.as_str() {
+                "SOURCE" => AnnotationRetention::Source,
+                "BINARY" => AnnotationRetention::Class,
+                "RUNTIME" => AnnotationRetention::Runtime,
+                _ => return Err(invalid(expression.offset, "Unknown annotation retention")),
+            };
+        } else if canonical == "kotlin/annotation/Target" {
+            let mut values = Vec::new();
+            for (_, expression) in &annotation.arguments {
+                let expressions = match &expression.kind { ExprKind::AnnotationArray(values) => values.as_slice(), _ => std::slice::from_ref(expression) };
+                for expression in expressions { values.push(enum_entry(expression, "kotlin/annotation/AnnotationTarget", &imports, cp)?); }
+            }
+            targets = Some(values);
+        }
+    }
+    let kotlin_targets = targets.unwrap_or_else(|| ["CLASS", "ANNOTATION_CLASS", "PROPERTY", "FIELD", "VALUE_PARAMETER", "CONSTRUCTOR", "FUNCTION", "PROPERTY_GETTER", "PROPERTY_SETTER", "LOCAL_VARIABLE", "TYPEALIAS"].into_iter().map(str::to_owned).collect());
+    let mut jvm_targets = Vec::new();
+    for target in &kotlin_targets {
+        let jvm = match target.as_str() {
+            "CLASS" => "TYPE", "ANNOTATION_CLASS" => "ANNOTATION_TYPE", "FIELD" => "FIELD", "VALUE_PARAMETER" => "PARAMETER", "CONSTRUCTOR" => "CONSTRUCTOR", "FUNCTION" | "PROPERTY_GETTER" | "PROPERTY_SETTER" => "METHOD", "LOCAL_VARIABLE" => "LOCAL_VARIABLE", "TYPE" => "TYPE_USE", "TYPE_PARAMETER" => "TYPE_PARAMETER", _ => continue,
+        };
+        if !jvm_targets.iter().any(|value| value == jvm) { jvm_targets.push(jvm.into()); }
+    }
+    let mut parameters = Vec::new();
+    let mut vararg = None;
+    for parameter in &source.parameters {
+        let ty = logical_type(&parameter.ty, &imports, cp, parameter.offset)?;
+        let mut descriptor = element_descriptor(&ty, cp, parameter.offset)?;
+        if parameter.vararg { descriptor.insert(0, '['); vararg = Some(parameter.name.clone()); }
+        parameters.push((parameter.name.clone(), descriptor, parameter.default.is_some()));
+    }
+    Ok(AnnotationDefinition { retention, targets: jvm_targets, parameters, kotlin_types: Vec::new(), kotlin_parameters: Some(source.parameters.iter().map(|p| p.name.clone()).collect()), kotlin_targets: Some(kotlin_targets), vararg })
+}
