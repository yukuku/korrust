+pub(crate) fn check(module: &Module, name: &str, cp: &Classpath) -> Result<CheckedAnnotation> {
+    let source = module.annotation_decl.as_ref().ok_or_else(|| invalid(0, "Missing annotation declaration"))?;
+    let definition = definition(module, name, cp)?;
+    let imports = imports(module, cp)?;
+    validate_cycles(name, cp, &mut Vec::new(), false, source.offset)?;
+    let mut parameters = Vec::new();
+    for (parameter, (_, descriptor, _)) in source.parameters.iter().zip(&definition.parameters) {
+        let element = logical_type(&parameter.ty, &imports, cp, parameter.offset)?;
+        let ty = if parameter.vararg { Type::primitive_array_for(&element).unwrap_or_else(|| if element == Type::String { Type::StringArray } else { Type::Array(Box::new(element.clone())) }) } else { element };
+        let default = parameter.default.as_ref().map(|expression| value(expression, descriptor, &imports, cp, 0, Some(name))).transpose()?;
+        parameters.push(CheckedParameter { name: parameter.name.clone(), ty, descriptor: descriptor.clone(), default, vararg: parameter.vararg });
+    }
+    let mut annotations = Vec::new();
+    for annotation in &source.annotations {
+        let canonical = owner(&annotation.name, &imports, cp);
+        let checked = if canonical == "kotlin/annotation/Retention" {
+            let entry = match definition.retention { AnnotationRetention::Source => "SOURCE", AnnotationRetention::Class => "BINARY", AnnotationRetention::Runtime => "RUNTIME" };
+            DeclarationAnnotation { descriptor: format!("L{canonical};"), runtime: true, values: vec![("value".into(), Value::Enum { descriptor: "Lkotlin/annotation/AnnotationRetention;".into(), entry: entry.into() })] }
+        } else if canonical == "kotlin/annotation/Target" {
+            DeclarationAnnotation { descriptor: format!("L{canonical};"), runtime: true, values: vec![("allowedTargets".into(), Value::Array(definition.kotlin_targets.as_ref().unwrap().iter().map(|entry| Value::Enum { descriptor: "Lkotlin/annotation/AnnotationTarget;".into(), entry: entry.clone() }).collect()))] }
+        } else {
+            if let Some(code) = crate::check::annotation_unsupported_lowering(&canonical) { return Err(unsupported(annotation.offset, "Annotation requires unsupported compiler semantics", code)); }
+            let class = cp.load(&canonical)?;
+            let policy = class.annotation_definition.as_ref().ok_or_else(|| invalid(annotation.offset, "Unsupported annotation definition"))?;
+            if policy.kotlin_targets.as_ref().map_or_else(|| !policy.targets.iter().any(|t| t == "ANNOTATION_TYPE" || t == "TYPE"), |targets| !targets.iter().any(|t| t == "ANNOTATION_CLASS")) { return Err(invalid(annotation.offset, "Annotation cannot target an annotation declaration")); }
