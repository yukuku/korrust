+        DeclarationAnnotationValue::String(value) => { out.push(b's'); u2(&mut out, pool.utf16(value)?); }
+        DeclarationAnnotationValue::Enum { descriptor, entry } => { out.push(b'e'); u2(&mut out, pool.utf8(descriptor)?); u2(&mut out, pool.utf8(entry)?); }
