+pub(crate) fn checked_use(annotation: &AnnotationUse, cp: &Classpath, imports: &HashMap<String, String>, scope: Option<&str>) -> Result<DeclarationAnnotation> {
+    arguments_value(&owner(&annotation.name, imports, cp), &annotation.arguments, annotation.offset, imports, cp, 0, scope)
+}
