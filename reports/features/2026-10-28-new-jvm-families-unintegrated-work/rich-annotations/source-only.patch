+pub(crate) fn imports(module: &Module, cp: &Classpath) -> Result<HashMap<String, String>> {
+    let mut bindings = module.imports.iter().filter(|(name, _, _)| name != "*").map(|(name, owner, _)| (name.clone(), owner.clone())).collect::<HashMap<_, _>>();
+    let mut wildcard = HashMap::<String, String>::new();
+    for (_, path, offset) in module.imports.iter().filter(|(name, _, _)| name == "*") {
+        let package = path.strip_suffix("/*").ok_or_else(|| invalid(*offset, "Malformed annotation wildcard import"))?;
+        for class in cp.package_classes(package)? {
+            if class.access & 1 == 0 { continue; }
+            let name = class.name.rsplit('/').next().unwrap().to_owned();
+            if bindings.contains_key(&name) { continue; }
+            if wildcard.get(&name).is_some_and(|previous| previous != &class.name) { return Err(invalid(*offset, "Ambiguous wildcard annotation classifier")); }
+            wildcard.insert(name, class.name);
+        }
+    }
+    bindings.extend(wildcard);
+    for class in cp.package_classes(&module.package.replace('.', "/"))? {
+        let name = class.name.rsplit('/').next().unwrap().to_owned();
+        bindings.entry(name).or_insert(class.name);
+    }
+    if let Some(annotation) = &module.annotation_decl {
+        let name = if module.package.is_empty() { annotation.name.clone() } else { format!("{}/{}", module.package.replace('.', "/"), annotation.name) };
+        bindings.insert(annotation.name.clone(), name);
+    }
+    Ok(bindings)
+}
