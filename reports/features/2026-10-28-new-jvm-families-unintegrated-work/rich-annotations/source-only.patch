+pub(crate) fn arguments_value(name: &str, arguments: &[(Option<String>, Expr)], offset: usize, imports: &HashMap<String, String>, cp: &Classpath, depth: usize, scope: Option<&str>) -> Result<DeclarationAnnotation> {
+    let class = cp.load(name)?;
+    let definition = class.annotation_definition.ok_or_else(|| invalid(offset, "Expected a supported annotation declaration"))?;
+    let mut supplied = HashSet::new();
+    let mut values = Vec::new();
+    let order = definition.kotlin_parameters.as_ref();
+    let mut variadic = Vec::new();
+    let mut positional_vararg = false;
+    if definition.vararg.as_ref().is_some_and(|name| definition.parameters.last().is_none_or(|(last, _, _)| last != name)) { return Err(unsupported(offset, "Nonfinal annotation varargs are unsupported", "ANNOTATION_VARARG_POSITION_UNSUPPORTED")); }
+    for (position, (key, expression)) in arguments.iter().enumerate() {
+        let key = key.clone().unwrap_or_else(|| order.and_then(|names| names.get(position)).cloned().or_else(|| definition.vararg.clone().filter(|_| order.is_some())).unwrap_or_else(|| "value".into()));
+        if order.is_none() && position != 0 && arguments[position].0.is_none() { return Err(invalid(expression.offset, "Java annotation arguments after value must be named")); }
+        let (_, descriptor, _) = definition.parameters.iter().find(|(name, _, _)| name == &key).ok_or_else(|| invalid(expression.offset, "Unknown annotation argument"))?;
+        if definition.vararg.as_deref() == Some(&key) && arguments[position].0.is_none() {
+            positional_vararg = true;
+            if let ExprKind::Unary(operator, expression) = &expression.kind && operator == "*" {
+                let Value::Array(items) = value(expression, descriptor, imports, cp, depth + 1, scope)? else { return Err(invalid(offset, "Expected spread annotation array")); }; variadic.extend(items);
+            } else { variadic.push(value(expression, &descriptor[1..], imports, cp, depth + 1, scope)?); }
+            continue;
+        }
+        if !supplied.insert(key.clone()) { return Err(invalid(expression.offset, "Duplicate annotation argument")); }
+        let checked = if order.is_none() && key == "value" && descriptor.starts_with('[') {
+            if let ExprKind::Unary(operator, expression) = &expression.kind && operator == "*" { value(expression, descriptor, imports, cp, depth + 1, scope)? }
+            else if matches!(expression.kind, ExprKind::AnnotationArray(_) | ExprKind::Call(_, _)) { value(expression, descriptor, imports, cp, depth + 1, scope)? }
+            else { Value::Array(vec![value(expression, &descriptor[1..], imports, cp, depth + 1, scope)?]) }
+        } else { value(expression, descriptor, imports, cp, depth + 1, scope)? };
+        values.push((key, checked));
+    }
+    if let Some(name) = &definition.vararg {
+        if positional_vararg && supplied.contains(name) { return Err(invalid(offset, "Duplicate annotation vararg argument")); }
+        if !supplied.contains(name) { supplied.insert(name.clone()); values.push((name.clone(), Value::Array(variadic))); }
+    }
+    if definition.parameters.iter().any(|(name, _, default)| !default && !supplied.contains(name)) { return Err(invalid(offset, "Missing required annotation argument")); }
+    Ok(DeclarationAnnotation { descriptor: format!("L{name};"), runtime: definition.retention == AnnotationRetention::Runtime, values })
+}
